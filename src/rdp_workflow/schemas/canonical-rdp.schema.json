        "capabilities": {
          "items": {
            "$ref": "#/$defs/CanonicalScopeEntry"
          },
          "title": "Capabilities",
          "type": "array"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "target_release": {
          "title": "Target Release",
          "type": "string"
        }
      },
      "required": [
        "summary",
        "target_release",
        "capabilities"
      ],
