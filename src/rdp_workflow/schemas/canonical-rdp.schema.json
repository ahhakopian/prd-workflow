          },
          "title": "Interactions",
          "type": "array"
        },
        "invariants": {
          "items": {
            "type": "string"
          },
          "title": "Invariants",
          "type": "array"
        },
        "non_responsibilities": {
          "items": {
            "type": "string"
          },
          "title": "Non Responsibilities",
          "type": "array"
