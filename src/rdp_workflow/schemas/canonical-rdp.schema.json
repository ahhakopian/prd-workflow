        "actors": {
          "items": {
            "$ref": "#/$defs/CanonicalActor"
          },
          "title": "Actors",
          "type": "array"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "summary",
        "actors"
      ],
      "title": "CanonicalActorsAndRoles",
      "type": "object"
    },
    "CanonicalArchitecture": {
      "additionalProperties": false,
      "description": "Only high-level architectural constraints downstream must preserve.",
      "properties": {
        "constraints": {
          "items": {
            "type": "string"
          },
          "title": "Constraints",
