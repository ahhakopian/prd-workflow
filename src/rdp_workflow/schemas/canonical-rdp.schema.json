{
  "$defs": {
    "CanonicalActor": {
      "additionalProperties": false,
      "description": "One human, system, or external actor referenced by the document.",
      "properties": {
        "actor_id": {
          "title": "Actor Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "HUMAN",
            "SYSTEM",
            "EXTERNAL"
          ],
          "title": "Kind",
          "type": "string"
        },
        "may_do": {
          "items": {
            "type": "string"
          },
          "title": "May Do",
          "type": "array"
        },
        "must_do": {
          "items": {
            "type": "string"
          },
          "title": "Must Do",
          "type": "array"
        },
        "must_not_do": {
          "items": {
            "type": "string"
          },
          "title": "Must Not Do",
          "type": "array"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "permission_boundaries": {
          "items": {
            "type": "string"
          },
          "title": "Permission Boundaries",
          "type": "array"
        },
        "purpose": {
          "title": "Purpose",
          "type": "string"
        }
      },
      "required": [
        "actor_id",
        "name",
        "kind",
        "purpose",
        "may_do",
        "must_do",
        "must_not_do",
        "permission_boundaries"
      ],
      "title": "CanonicalActor",
      "type": "object"
    },
    "CanonicalActorsAndRoles": {
      "additionalProperties": false,
      "description": "All material actors and their role or permission semantics.",
